<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desenha cada tela do aplicativo sem abrir janela (Avalonia.Headless + Skia) e grava um PNG: é o que o CI e a revisão de design olham. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Katharos.App\Katharos.App.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.23" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.23" />
  </ItemGroup>
</Project>

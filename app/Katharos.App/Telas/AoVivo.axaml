<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:k="using:Katharos.App"
             xmlns:c="using:Katharos.App.Controles"
             x:Class="Katharos.App.Telas.AoVivo">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <c:Secao>
        <Grid Margin="32,36,32,30" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="8">
            <TextBlock Classes="titulo"><Run Text="Ao vivo" /><Run Text="." Foreground="{x:Static k:Tema.Ambar}" /></TextBlock>
            <TextBlock Classes="sub" Text="O que o PC está fazendo agora e o que segura o jogo." />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Ellipse Width="8" Height="8" Fill="{x:Static k:Tema.Verde}" VerticalAlignment="Center" />
              <TextBlock Foreground="{x:Static k:Tema.Osso}" FontSize="14" Text="lendo a cada 1 s" />
            </StackPanel>
            <TextBlock Classes="rotulo" HorizontalAlignment="Right" Text="o Katharos usa 0,1 % da CPU" />
          </StackPanel>
        </Grid>
      </c:Secao>

      <!-- jogo aberto: o FPS de verdade e o que limita, em uma frase -->
      <c:Secao>
        <Grid Margin="32,24" ColumnDefinitions="*,Auto,Auto,Auto">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="rotulo" Text="Jogando agora · há 47 min" />
            <TextBlock Classes="forte" FontSize="21" Text="Elden Ring" />
            <TextBlock FontSize="14" Text="O limite é a placa de vídeo: ela está no máximo e a CPU sobra." TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
            <TextBlock Classes="rotulo" Text="FPS médio" />
            <TextBlock Classes="numero" Text="118" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="28,0,0,0" VerticalAlignment="Center">
            <TextBlock Classes="rotulo" Text="1% mais lento" />
            <TextBlock Classes="numero" Text="74" />
          </StackPanel>
          <StackPanel Grid.Column="3" Margin="28,0,0,0" VerticalAlignment="Center">
            <TextBlock Classes="rotulo" Text="travadas" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="numero" Text="2" /><TextBlock Classes="unidade" Text="por min" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </c:Secao>

      <!-- seis números grandes, cada um com o que ele quer dizer e os últimos 2 minutos -->
      <c:Secao>
        <ItemsControl x:Name="Metricas">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="k:Metrica">
              <Border Padding="32,22,32,20" BorderBrush="{x:Static k:Tema.Linha}" BorderThickness="0,0,1,1">
                <StackPanel Spacing="4">
                  <TextBlock Classes="rotulo" Text="{Binding Rotulo}" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="numero" Text="{Binding Valor}" /><TextBlock Classes="unidade" Text="{Binding Unidade}" />
                  </StackPanel>
                  <TextBlock FontSize="13" Foreground="{Binding CorContexto}" Text="{Binding Contexto}" TextTrimming="CharacterEllipsis" />
                  <c:Grafico Height="54" Margin="0,10,0,0" Valores="{Binding Valores}" Maximo="{Binding Maximo}" Limite="{Binding Limite}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </c:Secao>

      <c:Secao>
        <StackPanel>
          <Border Padding="32,22,32,10"><TextBlock Classes="forte" Text="O que fazer agora" /></Border>
          <Border Padding="32,16" BorderBrush="{x:Static k:Tema.Linha}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="92,*">
              <Border Classes="etiqueta" HorizontalAlignment="Left" BorderBrush="{x:Static k:Tema.Ambar}">
                <TextBlock Text="atenção" Foreground="{x:Static k:Tema.Ambar}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Foreground="{x:Static k:Tema.Osso}" FontSize="15" FontWeight="SemiBold" Text="Memória da placa de vídeo quase cheia" />
                <TextBlock Classes="rotulo" FontSize="13.5" TextWrapping="Wrap" Text="7,9 de 8 GB. Baixe a qualidade das texturas no jogo: acima disso ele engasga." />
              </StackPanel>
            </Grid>
          </Border>
          <Border Padding="32,16" BorderBrush="{x:Static k:Tema.Linha}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="92,*">
              <Border Classes="etiqueta" HorizontalAlignment="Left" BorderBrush="{x:Static k:Tema.Apagado}">
                <TextBlock Text="normal" Foreground="{x:Static k:Tema.Apagado}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Foreground="{x:Static k:Tema.Osso}" FontSize="15" FontWeight="SemiBold" Text="A placa de vídeo é o limite" />
                <TextBlock Classes="rotulo" FontSize="13.5" TextWrapping="Wrap" Text="Isso é o esperado num jogo pesado. Mais FPS vem de baixar resolução ou qualidade, não de otimizar o Windows." />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </c:Secao>
    </StackPanel>
  </ScrollViewer>
</UserControl>
